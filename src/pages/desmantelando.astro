  .ux-examples section > a { display: inline-flex; align-items: center; gap: 7px; font-size: .73rem; margin-top: 14px; font-weight: 700; }
  .file-flow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; padding: 0; margin: 30px 0; background: #fffefa; border: 1px solid var(--ink); }
  .file-flow li { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 9px; padding: 23px 19px; }
  .file-flow li + li { border-left: 1px solid var(--line); }
  .file-flow li:not(:last-child)::after { content: '→'; position: absolute; right: -9px; top: 24px; z-index: 1; background: var(--yellow); line-height: 1; font-size: 1.1rem; }
  .file-flow svg { color: var(--deep-red); margin-bottom: 8px; }
  .file-flow strong { font-size: .8rem; line-height: 1.5; }
  .file-flow li span { font-size: .65rem; color: var(--muted); line-height: 1.5; }
  blockquote { margin: 35px 0; padding: 30px 0 30px 26px; border-left: 7px solid var(--red); font-family: Barlow, Impact, sans-serif; font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 700; font-style: italic; line-height: 1.1; text-transform: uppercase; }
  .editorial-section .editorial-conclusion { font-weight: 650; }
  .editorial-method { margin-top: 48px; padding: 32px; background: #f0ebdf; border-top: 4px solid var(--ink); scroll-margin-top: 112px; }
  .editorial-method h2 { font-family: Inter, Arial, sans-serif; font-style: normal; text-transform: none; font-size: 1.3rem; line-height: 1.4; margin-bottom: 20px; }
  .editorial-method p { font-size: .81rem; line-height: 1.85; margin-bottom: 17px; }
  .editorial-method h3 { font-size: .94rem; margin: 29px 0 15px; }
  .references { padding-left: 19px; margin-bottom: 0; }
  .references li { font-size: .76rem; line-height: 1.7; margin-bottom: 14px; padding-left: 5px; overflow-wrap: anywhere; }

---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { videos, sourceProfiles } from '../lib/content';
---
<Layout title="Vídeos e publicações nas redes — Todos com Lula">
  <section class="page-heading paper-pattern"><div class="container"><a href="/" class="breadcrumb">Início <span>/</span> Vídeos</a><span class="eyebrow">DE UM PLAY PARA MUITAS CONVERSAS</span><h1>Dê o play.<br /><span class="red-word">Passe adiante.</span></h1><p>Vídeos com autoria, link original e compartilhamento em um só lugar.</p></div></section>
  <section class="section container" data-gallery>
    {videos.length ? <><div class="search-row"><label class="search-box"><Icon name="search" /><input type="search" data-search-input placeholder="Buscar vídeos" aria-label="Buscar vídeos" /></label><span data-gallery-count>{videos.length} conteúdos</span></div><div class="video-grid">{videos.map((post) => <PostCard post={post} variant="video" />)}</div><p data-gallery-empty class="gallery-empty" hidden>Nenhum vídeo encontrado. Experimente outra busca.</p></> : <div class="video-empty"><span class="video-empty-icon"><Icon name="play" size={42} /></span><span class="eyebrow">ACOMPANHE NA FONTE</span><h2>Os vídeos estão<br />nas redes.</h2><p>Nosso acervo de vídeos ainda não tem arquivos disponíveis. Enquanto isso, acompanhe os perfis de origem e compartilhe os cards do site.</p><div class="hero-buttons"><a class="button button-red" href="https://www.instagram.com/lulaoficial/reels/" target="_blank" rel="noopener noreferrer"><Icon name="instagram" /> Ver vídeos do Lula</a><a class="button button-yellow" href="/cards/">Baixar cards <Icon name="download" /></a></div></div>}
    <div class="source-page-intro"><h2>Mais vozes para acompanhar</h2><a class="text-link" href="/fontes/">Ver todos os perfis <Icon name="arrow" size={18} /></a></div><div class="source-strip">{sourceProfiles.slice(1, 6).map((source) => <a class="source-small" href={`https://www.instagram.com/${source.username}/reels/`} target="_blank" rel="noopener noreferrer"><span class:list={['source-avatar', source.color]}>{source.initials}</span><b>{source.name}</b><span>@{source.username}</span><Icon name="arrow" size={17} /></a>)}</div>
  </section>
</Layout>

---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import ShareDialog from '../components/ShareDialog.astro';
interface Props { title?: string; description?: string; image?: string; }
const {
  title = 'Todos com Lula — informação para compartilhar',
  description = 'Conteúdos sobre o Brasil, cards para compartilhar e uma rede de fontes para acompanhar. Todos com Lula: informação que circula.',
  image = '/images/lula-hero.webp',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#D51D38" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/barlow-condensed-bold-italic.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main" class="skip-link">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Todos com Lula — página inicial"><span class="brand-star">★</span><span class="brand-words">TODOS<span>COM LULA</span></span></a>
        <nav class="main-nav" id="main-nav" aria-label="Navegação principal">
          <a href="/#assuntos">Assuntos</a><a href="/cards/">Cards</a><a href="/videos/">Vídeos</a><a href="/fontes/">Nas redes</a>
        </nav>
        <div class="header-actions">
          <button class="button button-yellow header-share" type="button" data-share-site><Icon name="whatsapp" size={18} /><span>Mandar no WhatsApp</span></button>
          <button class="menu-toggle icon-button" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="main-nav"><Icon name="menu" /></button>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-main container">
        <div><a href="/" class="brand footer-brand"><span class="brand-star">★</span><span class="brand-words">TODOS<span>COM LULA</span></span></a><p>Informação tem força<br />quando a gente compartilha.</p></div>
        <div><span class="footer-label">EXPLORE</span><a href="/cards/">Cards para compartilhar</a><a href="/videos/">Vídeos</a><a href="/fontes/">Perfis nas redes</a></div>
        <div><span class="footer-label">ACOMPANHE A CONVERSA</span><a href="https://www.instagram.com/boraaalula2026/" target="_blank" rel="noopener noreferrer">Nosso Instagram: @boraaalula2026 <Icon name="arrow" size={15} /></a><a href="https://www.instagram.com/lulaoficial/" target="_blank" rel="noopener noreferrer">Instagram do Lula <Icon name="arrow" size={15} /></a><a href="https://www.gov.br/planalto/pt-br" target="_blank" rel="noopener noreferrer">Presidência da República <Icon name="arrow" size={15} /></a><a href="/sobre/">Sobre este projeto</a></div>
      </div>
      <div class="footer-bottom container"><span>© {new Date().getFullYear()} Todos com Lula. Projeto independente, sem vínculo institucional.</span><a href="/privacidade/">Privacidade</a><a href="/creditos/">Créditos e fontes</a></div>
    </footer>
    <button class="accessibility-trigger" type="button" aria-label="Opções de acessibilidade" aria-expanded="false" aria-controls="accessibility-panel"><Icon name="accessible" size={23} /></button>
    <section id="accessibility-panel" class="accessibility-panel" aria-label="Opções de acessibilidade" hidden>
      <h2>Acessibilidade</h2>
      <div class="font-controls"><button type="button" data-font="decrease" aria-label="Diminuir texto">A−</button><button type="button" data-font="increase" aria-label="Aumentar texto">A+</button></div>
      <label><input type="checkbox" id="high-contrast" /> Alto contraste</label>
      <label><input type="checkbox" id="reduce-motion" /> Reduzir movimento</label>
      <button type="button" class="text-link" id="reset-accessibility">Restaurar preferências</button>
    </section>
    <ShareDialog />
    <script>
      import '../scripts/site.ts';
      import '../scripts/analytics.ts';
    </script>
  </body>
</html>

---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { EvidenceRecord } from '../data/desmantelando';

interface Props { record: EvidenceRecord; priority?: boolean; compact?: boolean; }
const { record, priority = false, compact = false } = Astro.props;
const fullImage = await getImage({ src: record.image, format: 'webp', quality: 95 });
const widths = [...new Set([480, 960, 1440, record.image.width].filter((width) => width <= record.image.width))].sort((a, b) => a - b);
---

<figure class:list={['evidence', { compact }]} id={`registro-${record.number}`}>
  <a class="evidence-image" href={fullImage.src} target="_blank" rel="noopener noreferrer" aria-label={`Ampliar registro ${record.number}: ${record.title} (abre em nova aba)`}>
    <Image src={record.image} alt={record.alt} format="webp" quality={85} widths={widths} sizes={compact ? '(max-width: 640px) calc(100vw - 36px), (max-width: 1000px) 45vw, 390px' : '(max-width: 640px) calc(100vw - 36px), (max-width: 1000px) 90vw, 820px'} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} />
    <span class="evidence-zoom"><Icon name="search" size={15} /> Ampliar</span>
  </a>
  <figcaption>
    <span class="evidence-number">REGISTRO {record.number}</span>
    <strong>{record.title}</strong>
    <p>{record.caption}</p>
  </figcaption>
</figure>

<style>
  .evidence { margin: 30px 0; min-width: 0; border: 1px solid var(--line); background: #fffefa; scroll-margin-top: 110px; }
  .evidence-image { position: relative; display: block; background: #141514; overflow: hidden; }
  .evidence-image img { display: block; width: 100%; height: auto; }
  .evidence-image:hover .evidence-zoom { background: var(--yellow); color: var(--ink); }
  .evidence-zoom { position: absolute; right: 10px; bottom: 10px; display: inline-flex; gap: 7px; align-items: center; padding: 8px 11px; background: #181916ed; color: white; font: 700 .65rem/1.2 Inter, Arial, sans-serif; border: 1px solid #ffffff60; border-radius: 3px; }
  figcaption { padding: 19px 21px 20px; }
  .evidence-number { display: block; color: var(--deep-red); font: 800 .57rem/1.5 Inter, Arial, sans-serif; letter-spacing: .12em; margin-bottom: 7px; }
  figcaption strong { display: block; font-size: .86rem; line-height: 1.4; }
  figcaption p { font-size: .73rem; line-height: 1.7; color: var(--muted); margin: 7px 0 0; }
  .compact { margin: 0; }
  .compact .evidence-image { aspect-ratio: 4 / 3; display: grid; place-items: center; }
  .compact .evidence-image img { width: 100%; height: 100%; object-fit: contain; }
  @media (max-width: 640px) { figcaption { padding: 16px; } .evidence { margin-block: 24px; } .compact { margin: 0; } }
</style>
